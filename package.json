{
  "name": "polyhydra-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "build:blender": "vite build --outDir _blender_tmp/web --emptyOutDir && node scripts/zip-blender-addon.mjs",
    "deploy:cloudflare": "node scripts/deploy-cloudflare.mjs",
    "horizon:configure": "node scripts/configure-horizon-pwa.mjs",
    "horizon:doctor": "bubblewrap doctor",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs",
    "pwa:validate": "node scripts/validate-pwa.mjs",
    "predeploy:cloudflare": "npm run build",
    "preview": "vite preview",
    "clean": "rimraf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.184.0",
    "three-html-render": "^0.1.2"
  },
  "devDependencies": {
    "@meta-quest/bubblewrap-cli": "1.24.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "rimraf": "^6.1.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wrangler": "4.112.0"
  }
}
